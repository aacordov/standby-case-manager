# ==========================================
# Frontend Dockerfile - PRODUCCIÓN (OPTIMIZADO)
# ==========================================
# Multi-stage build basado en el Dockerfile de desarrollo
# Usa Bun + Build sin type check estricto + Nginx
# Con soporte para versión dinámica
# ==========================================

# ==========================================
# STAGE 1: Dependencies
# ==========================================
FROM oven/bun:1-alpine AS dependencies

WORKDIR /app

# Copiar archivos de dependencias
COPY package.json bun.lock* ./

# Instalar todas las dependencias (incluyendo devDependencies)
RUN bun install --frozen-lockfile

# ==========================================
# STAGE 2: Builder
# ==========================================
FROM oven/bun:1-alpine AS builder

# ✅ Build arguments para versión dinámica
ARG VITE_APP_VERSION=2.3.0
ARG VITE_APP_BUILD_DATE
ARG VITE_APP_ENVIRONMENT=production

# Metadata
LABEL stage="builder"
LABEL description="Build stage con Bun"

WORKDIR /app

# Copiar dependencias instaladas desde stage anterior
COPY --from=dependencies /app/node_modules ./node_modules

# Copiar código fuente completo
COPY . .

# ✅ Pasar variables de entorno al build de Vite
ENV VITE_APP_VERSION=${VITE_APP_VERSION}
ENV VITE_APP_BUILD_DATE=${VITE_APP_BUILD_DATE}
ENV VITE_APP_ENVIRONMENT=${VITE_APP_ENVIRONMENT}

# ✅ Build de producción
# IMPORTANTE: Si package.json tiene "build": "tsc && vite build"
# y falla con errores de TypeScript, cambiar a:
# package.json: "build": "vite build"
# Esto omite el type check y solo hace el build
RUN bun run build

# Verificar que el build se creó correctamente
RUN ls -la /app/dist && \
    echo "✅ Build completado. Archivos generados:" && \
    ls -lh /app/dist/

# ==========================================
# STAGE 3: Production Runtime con Nginx
# ==========================================
FROM nginx:1.25-alpine

# Metadata
LABEL maintainer="Standby Case Manager Team"
LABEL version="2.3.0"
LABEL description="Frontend React + Vite - Production Environment"

# Copiar build estático desde builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copiar configuración de Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Crear usuario no-root para Nginx (seguridad)
RUN addgroup -g 1000 -S appuser && \
    adduser -u 1000 -S appuser -G appuser && \
    chown -R appuser:appuser /usr/share/nginx/html && \
    chown -R appuser:appuser /var/cache/nginx && \
    chown -R appuser:appuser /var/log/nginx && \
    chown -R appuser:appuser /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R appuser:appuser /var/run/nginx.pid

# Verificar que los archivos están en su lugar
RUN echo "✅ Archivos en Nginx:" && \
    ls -lh /usr/share/nginx/html/ && \
    echo "✅ index.html existe:" && \
    test -f /usr/share/nginx/html/index.html && echo "OK"

# Cambiar a usuario no-root
USER appuser

# Exponer puerto 80
EXPOSE 80

# Health check (similar al de desarrollo)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80 || exit 1

# Comando: iniciar Nginx en foreground
CMD ["nginx", "-g", "daemon off;"]